source "https://rubygems.org"

# github-pages pins Jekyll + plugins to exactly what GitHub's servers run,
# so a page that builds locally is guaranteed to build the same way on GitHub Pages.
gem "github-pages", group: :jekyll_plugins

group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-seo-tag"
  gem "jekyll-sitemap"
end

# Windows/JRuby compatibility shims (harmless on other platforms)
platforms :mingw, :x64_mingw, :mswin, :jruby do
  gem "tzinfo", ">= 1", "< 3"
  gem "tzinfo-data"
end
